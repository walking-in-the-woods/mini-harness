# ── Выбор бэкенда инференса ───────────────────────────────────────────────
# ollama   — нативный ollama-python (OLLAMA_HOST)
# llamacpp — прямой OpenAI-совместимый HTTP (LLAMACPP_HOST)
#
# Значение по умолчанию — ollama. При переключении на llamacpp
# не забудьте поменять HARNESS_MODEL и HARNESS_NUM_CTX ниже:
# контекст и модель определяются флагами запуска llama-server,
# а не .env. Согласуйте их вручную.
HARNESS_BACKEND=ollama

# ── Модель ────────────────────────────────────────────────────────────────
# Для ollama: имя модели, загруженной в ollama serve.
# Для llamacpp: произвольная метка, llama-server игнорирует поле model.
#               Если пусто, harness подставит "llamacpp-local".
HARNESS_MODEL=qwen3:1.7b

# ── Ollama (при HARNESS_BACKEND=ollama) ───────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434

# ── llama.cpp (при HARNESS_BACKEND=llamacpp) ──────────────────────────────
# Адрес llama-server. Скрипты запуска из инструкции используют порты
# 8080 (3B), 8081 (4B), 8082 (7B). Backend ходит на /v1/chat/completions.
LLAMACPP_HOST=http://127.0.0.1:8080

# API-ключ. llama-server по умолчанию работает без аутентификации,
# оставьте пустым. Если запускаете через reverse-proxy с auth —
# впишите токен, он уйдёт в заголовке Authorization: Bearer <...>.
LLAMACPP_API_KEY=

# Таймаут HTTP-запроса. Дефолт 300 секунд — на N100+7B Q4 ответ
# на 1024 токена генерируется 4–8 минут. Уменьшать не рекомендуется
# без причины: увидите обрыв на середине.
LLAMACPP_TIMEOUT=300

# ── Параметры генерации ───────────────────────────────────────────────────
# ВНИМАНИЕ: при HARNESS_BACKEND=llamacpp num_ctx и keep_alive
# игнорируются:
#   * контекст задаётся флагом --ctx-size при запуске llama-server;
#   * модель всегда в RAM (или в mmap), выгрузки по таймауту нет.
# HARNESS_NUM_CTX ниже всё ещё используется harness'ом для обрезки
# источника в guided mode и для расчёта бюджета chunked-режима —
# держите его равным или меньшим, чем --ctx-size на сервере.
HARNESS_NUM_CTX=1024

# Максимум токенов в ответе. При llamacpp уходит в max_tokens.
# Reasoning-фаза у llama.cpp отсутствует (chat-template решает),
# 2048 обычно с запасом.
HARNESS_NUM_PREDICT=2048

# Сколько держать модель в памяти после запроса. Только для ollama.
HARNESS_KEEP_ALIVE=5m

# Температура генерации.
HARNESS_TEMPERATURE=0.1

# ── Рабочие директории ────────────────────────────────────────────────────
HARNESS_WORKSPACE=./workspace
HARNESS_AUDIT_PATH=./logs/audit.jsonl

# ── Лимиты tool-loop ──────────────────────────────────────────────────────
HARNESS_MAX_TOOL_ROUNDS=4

# ── Лимиты файловых операций ──────────────────────────────────────────────
HARNESS_MAX_READ_BYTES=200000
HARNESS_MAX_WRITE_BYTES=1000000
HARNESS_MAX_LIST_ENTRIES=500

# ── Внешний прокси ────────────────────────────────────────────────────────
HARNESS_PROXY_TIMEOUT=30
HARNESS_PROXY_MAX_REQUEST_BYTES=100000
HARNESS_PROXY_MAX_RESPONSE_BYTES=200000

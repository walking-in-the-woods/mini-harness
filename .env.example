# ── Модель и локальный сервер ─────────────────────────────────────────────
# В .env.example указана модель, которую вы назвали целевой.
# Правьте .env, а не этот файл.
HARNESS_MODEL=qwen3:1.7b

# Адрес локально установленного сервера.
OLLAMA_HOST=http://127.0.0.1:11434

# ── Параметры генерации ───────────────────────────────────────────────────
# Размер контекстного окна. KV-cache растёт линейно с этим значением.
# 1024 — оптимум для машин с 1.5 ГБ свободной RAM; 2048 удваивает
# KV-cache. На машинах с 12+ ГБ свободной RAM безопасно 2048.
HARNESS_NUM_CTX=1024

# Максимум токенов в ответе модели. Reasoning-фаза отключена в коде
# (think=False), но модели 4B+ иногда всё равно выводят рассуждения.
# 2048 даёт запас для retry, если сработал детектор reasoning-leakage.
HARNESS_NUM_PREDICT=2048

# Сколько держать модель в памяти после запроса.
#   * 30s — модель выгружается между вашими паузами, RAM свободна,
#     но следующий запрос платит ~4 секунды на загрузку.
#   * 10m — модель остаётся в RAM, все запросы в сессии быстрые,
#     но занято место под веса постоянно.
# На машинах с 12+ ГБ свободных выгоднее 10m.
HARNESS_KEEP_ALIVE=5m

# Температура генерации.
HARNESS_TEMPERATURE=0.1

# ── Рабочие директории ────────────────────────────────────────────────────
HARNESS_WORKSPACE=./workspace
HARNESS_AUDIT_PATH=./logs/audit.jsonl

# ── Лимиты tool-loop ──────────────────────────────────────────────────────
HARNESS_MAX_TOOL_ROUNDS=4

# ── Лимиты файловых операций ──────────────────────────────────────────────
HARNESS_MAX_READ_BYTES=200000
HARNESS_MAX_WRITE_BYTES=1000000
HARNESS_MAX_LIST_ENTRIES=500

# ── Внешний прокси ────────────────────────────────────────────────────────
HARNESS_PROXY_TIMEOUT=30
HARNESS_PROXY_MAX_REQUEST_BYTES=100000
HARNESS_PROXY_MAX_RESPONSE_BYTES=200000
